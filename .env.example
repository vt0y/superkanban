VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-me

# Optional: reCAPTCHA v3 key used by Firebase App Check. Leave empty to disable App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Allowed email domains for registration / login (space- or comma-separated, e.g. "example.com xxx.xyx")
# Leave empty to allow all email domains.
ALLOWED_EMAIL_DOMAINS="example.com"

# GitHub Integration (disabled by default; needs BOTH the flag and your GitHub App slug)
CONNECTS_GITHUB=false
# Slug from https://github.com/apps/<slug>
CONNECTS_GITHUB_APP_SLUG=

# Google Drive attachments (disabled unless all three values are configured).
# Enable the Google Drive API and Google Picker API in this Google Cloud project.
CONNECTS_GOOGLE_DRIVE=false
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=

# Mystic Tarot: public Worker endpoint and public card-image CDN base URL.
# KKU_API_KEY and other server-only values belong in Cloudflare Worker secrets, never here.
VITE_TAROT_API_URL=https://tarot-api.example.workers.dev
VITE_TAROT_CDN_BASE_URL=https://tarot-cards.example.com
