rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enforced on every request, so accounts created before a domain was removed lose access too.
    function signedIn() { return request.auth != null && isAllowedEmail(request.auth.token.email); }
    function siteAdminPath(uid) { return /databases/$(database)/documents/siteAdmins/$(uid); }
    function isSiteStaff() {
      return signedIn() && exists(siteAdminPath(request.auth.uid))
        && get(siteAdminPath(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function membershipPath(projectId, uid) { return /databases/$(database)/documents/memberships/$(projectId + '_' + uid); }
    function projectDocumentPath(projectId, itemId) { return /databases/$(database)/documents/projects/$(projectId)/documents/$(itemId); }
    function projectDocumentBodyPath(projectId, itemId) { return /databases/$(database)/documents/projects/$(projectId)/documentBodies/$(itemId); }
    function membership(projectId) { return get(membershipPath(projectId, request.auth.uid)); }
    function isMember(projectId) { return signedIn() && exists(membershipPath(projectId, request.auth.uid)); }
    function isAdmin(projectId) { return isMember(projectId) && membership(projectId).data.role in ['owner', 'admin']; }
    function isOwner(projectId) { return isMember(projectId) && membership(projectId).data.role == 'owner'; }
    function projectActive(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.archived == false;
    }
    function inviteAvailable(data) {
      return data.status == 'active'
        && (data.expiresAt == null || request.time < data.expiresAt)
        && (data.get('maxUses', null) == null || data.get('usesCount', 0) < data.maxUses);
    }
    function validInviteSettings(data) {
      return data.role in ['admin', 'member'] && data.status in ['active', 'paused', 'revoked']
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && (data.get('name', '') is string && data.get('name', '').size() <= 120)
        && (data.get('maxUses', null) == null || (data.maxUses is int && data.maxUses > 0))
        && data.get('usesCount', 0) is int && data.get('usesCount', 0) >= 0;
    }
    function validInviteJoin(data) {
      let path = /databases/$(database)/documents/invites/$(data.inviteId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return inviteAvailable(before) && before.projectId == data.projectId && before.role == data.role
        && after.diff(before).affectedKeys().hasOnly(['usesCount', 'updatedAt'])
        && after.usesCount == before.get('usesCount', 0) + 1
        && after.updatedAt == request.time
        && request.auth.uid in getAfter(/databases/$(database)/documents/projects/$(data.projectId)).data.memberIds;
    }
    function validRole(role) { return role in ['owner', 'admin', 'member']; }
    function hasGitHubIdentity() {
      return 'firebase' in request.auth.token && 'identities' in request.auth.token.firebase && 'github.com' in request.auth.token.firebase.identities;
    }
    // A GitHub handle may only be written by someone whose token proves they own a GitHub identity.
    function githubHandleProven() { return !('githubUsername' in request.resource.data) || hasGitHubIdentity(); }
    function validWorkCreate(projectId) { return projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == request.auth.uid; }
    function canDeleteWork(projectId) { return projectActive(projectId) && (isAdmin(projectId) || (isMember(projectId) && resource.data.createdBy == request.auth.uid)); }
    // [ALLOWED_EMAIL_DOMAINS_START]
    function isAllowedEmail(email) {
      return email is string && email.matches('^[a-zA-Z0-9._%+-]+@[kK][kK][uU][mM][aA][iI][lL][.][cC][oO][mM]$');
    }
    // [ALLOWED_EMAIL_DOMAINS_END]

    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && isAllowedEmail(request.auth.token.email);
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'locale', 'theme', 'updatedAt', 'githubUsername', 'githubId', 'githubConnectedAt'])
        && githubHandleProven();
      allow delete: if false;

      match /tarotReadings/{readingId} {
        function validCardAt(index, expectedPosition) {
          return request.resource.data.cards[index] is map
            && request.resource.data.cards[index].keys().hasOnly(['id', 'position', 'reversed', 'nameTh', 'nameEn'])
            && request.resource.data.cards[index].id is string
            && request.resource.data.cards[index].id.size() > 0
            && request.resource.data.cards[index].id.size() <= 40
            && request.resource.data.cards[index].position == expectedPosition
            && request.resource.data.cards[index].reversed is bool
            && request.resource.data.cards[index].nameTh is string
            && request.resource.data.cards[index].nameTh.size() <= 80
            && request.resource.data.cards[index].nameEn is string
            && request.resource.data.cards[index].nameEn.size() <= 80;
        }
        allow read: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['schemaVersion','category','question','locale','cards','readingMarkdown','requestId','createdBy','createdAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.category in ['general','love','work','finance']
          && request.resource.data.question is string && request.resource.data.question.size() <= 500
          && request.resource.data.locale in ['th','en']
          && request.resource.data.cards is list && request.resource.data.cards.size() == 3
          && validCardAt(0, 'past') && validCardAt(1, 'present') && validCardAt(2, 'future')
          && request.resource.data.cards[0].id != request.resource.data.cards[1].id
          && request.resource.data.cards[0].id != request.resource.data.cards[2].id
          && request.resource.data.cards[1].id != request.resource.data.cards[2].id
          && request.resource.data.readingMarkdown is string
          && request.resource.data.readingMarkdown.size() > 0 && request.resource.data.readingMarkdown.size() <= 16000
          && request.resource.data.requestId is string && request.resource.data.requestId.size() > 0 && request.resource.data.requestId.size() <= 128
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && uid == request.auth.uid && resource.data.createdBy == request.auth.uid;
      }
    }

    match /projects/{projectId} {
      allow get: if isMember(projectId) || (signedIn() && request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.archived == false
        && getAfter(membershipPath(projectId, request.auth.uid)).data.role == 'owner';
      allow update: if (resource.data.archived == true
        && isOwner(projectId)
        && request.resource.data.archived == false
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived','updatedAt']))
        || (resource.data.archived == false && isOwner(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','color','archived','memberIds','githubRepo','updatedAt']))
        || (resource.data.archived == false && isAdmin(projectId) && !isOwner(projectId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.archived == resource.data.archived
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','color','memberIds','updatedAt']))
        || (resource.data.archived == false && signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
        && getAfter(membershipPath(projectId, request.auth.uid)).data.userId == request.auth.uid)
        || (resource.data.archived == false && isMember(projectId) && membership(projectId).data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          && !existsAfter(membershipPath(projectId, request.auth.uid)));
      allow delete: if false;

      function validTime(key) {
        return !(key in request.resource.data) || (request.resource.data[key] is string && request.resource.data[key].matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$'));
      }
      function validLabelIds() {
        return !('labelIds' in request.resource.data) || (request.resource.data.labelIds is list && request.resource.data.labelIds.size() <= 50);
      }
      function validDocumentLinks() {
        return (!('taskIds' in request.resource.data) || (request.resource.data.taskIds is list && request.resource.data.taskIds.size() <= 100))
          && (!('milestoneIds' in request.resource.data) || (request.resource.data.milestoneIds is list && request.resource.data.milestoneIds.size() <= 100));
      }
      function validTaskLists() {
        return validLabelIds()
          && (!('checklist' in request.resource.data) || (request.resource.data.checklist is list && request.resource.data.checklist.size() <= 100));
      }
      // Elevated roles only for Google Docs/Sheets/Slides, and never edit access for anyone-with-the-link.
      function validDriveRole() {
        return !('role' in request.resource.data)
          || request.resource.data.role == 'reader'
          || (request.resource.data.role in ['commenter', 'writer']
            && request.resource.data.mimeType in ['application/vnd.google-apps.document', 'application/vnd.google-apps.spreadsheet', 'application/vnd.google-apps.presentation']
            && !(request.resource.data.shareMode == 'link' && request.resource.data.role == 'writer'));
      }
      function validDriveMetadata() {
        return request.resource.data.driveFileId is string
          && request.resource.data.driveFileId.size() > 0 && request.resource.data.driveFileId.size() <= 200
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 240
          && request.resource.data.mimeType is string && request.resource.data.mimeType.size() <= 160
          && (!('resourceKey' in request.resource.data) || (request.resource.data.resourceKey is string
            && request.resource.data.resourceKey.matches('^[A-Za-z0-9_-]{1,512}$')))
          && (!('sizeBytes' in request.resource.data) || (request.resource.data.sizeBytes is int && request.resource.data.sizeBytes >= 0))
          && request.resource.data.shareMode in ['members', 'link', 'unmanaged']
          && request.resource.data.sharedMemberIds is list && request.resource.data.sharedMemberIds.size() <= 200
          && (!('managedPermissionIds' in request.resource.data)
            || (request.resource.data.managedPermissionIds is map && request.resource.data.managedPermissionIds.size() <= 200))
          && (!('permissionsSyncedAt' in request.resource.data) || request.resource.data.permissionsSyncedAt is timestamp)
          && validDriveRole()
          && (!('linkPermissionId' in request.resource.data)
            || (request.resource.data.shareMode == 'link' && request.resource.data.linkPermissionId is string
              && request.resource.data.linkPermissionId.size() > 0 && request.resource.data.linkPermissionId.size() <= 200))
          && ((request.resource.data.shareMode == 'unmanaged' && request.resource.data.sharedMemberIds.size() == 0
              && !request.resource.data.keys().hasAny(['managedPermissionIds', 'permissionsSyncedAt', 'role']))
            || (request.resource.data.shareMode == 'link' && request.resource.data.sharedMemberIds.size() == 0)
            // Member lists must match the project only when written; details edits keep a list that may
            // have drifted after membership changes (the uploader re-syncs it explicitly).
            || (request.resource.data.shareMode == 'members'
              && ((resource != null && resource.data.get('shareMode', '') == 'members' && request.resource.data.sharedMemberIds == resource.data.sharedMemberIds)
                || (request.resource.data.sharedMemberIds.hasOnly(get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds)
                  && get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds.hasOnly(request.resource.data.sharedMemberIds)))));
      }
      match /tasks/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId)
          && request.resource.data.keys().hasOnly(['title','description','status','priority','assigneeIds','tags','labelIds','checklist','dueDate','dueTime','milestoneId','order','createdBy','createdAt','updatedAt'])
          && request.resource.data.status in ['backlog','todo','in_progress','review','done'] && request.resource.data.priority in ['low','medium','high','urgent']
          && validTaskLists() && validTime('dueTime');
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(['title','description','status','priority','assigneeIds','tags','labelIds','checklist','dueDate','dueTime','milestoneId','order','createdBy','createdAt','updatedAt'])
          && validTaskLists() && validTime('dueTime');
        allow delete: if canDeleteWork(projectId);
      }
      match /taskAttachments/{itemId} {
        allow read: if isMember(projectId);
        allow create, update: if false;
        allow delete: if projectActive(projectId) && (isAdmin(projectId)
          || (isMember(projectId) && resource.data.createdBy == request.auth.uid)
          || (isMember(projectId) && get(/databases/$(database)/documents/projects/$(projectId)/tasks/$(resource.data.taskId)).data.createdBy == request.auth.uid));
      }
      match /milestones/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(['title','description','dueDate','dueTime','status','dependsOn','createdBy','createdAt','updatedAt']) && request.resource.data.status in ['active','completed']
          && (!('dependsOn' in request.resource.data) || request.resource.data.dependsOn is list) && validTime('dueTime');
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.keys().hasOnly(['title','description','dueDate','dueTime','status','dependsOn','createdBy','createdAt','updatedAt'])
          && request.resource.data.status in ['active','completed']
          && (!('dependsOn' in request.resource.data) || request.resource.data.dependsOn is list) && validTime('dueTime');
        allow delete: if canDeleteWork(projectId);
      }
      match /labels/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(['name','color','description','createdBy','createdAt','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50 && request.resource.data.color is string;
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(['name','color','description','createdBy','createdAt','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50;
        allow delete: if canDeleteWork(projectId);
      }
      match /useCases/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(['code','title','actor','details','businessRules','assigneeId','status','createdBy','createdAt','updatedAt']) && request.resource.data.status in ['open','assigned','completed'];
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.keys().hasOnly(['code','title','actor','details','businessRules','assigneeId','status','createdBy','createdAt','updatedAt']);
        allow delete: if canDeleteWork(projectId);
      }
      match /stickyNotes/{itemId} {
        function validNote() {
          return request.resource.data.keys().hasOnly(['kind','content','color','x','y','taskId','pinned','documentIds','createdBy','createdAt','updatedAt'])
            && (!('kind' in request.resource.data) || request.resource.data.kind == 'note')
            && request.resource.data.content is string && request.resource.data.content.size() <= 800
            && request.resource.data.x is number && request.resource.data.y is number
            && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool)
            && (!('color' in request.resource.data) || request.resource.data.color in ['#ffffff','#fef3c7','#dbeafe','#dcfce7','#fce7f3','#ede9fe'])
            && request.resource.data.get('documentIds', []) is list
            && request.resource.data.get('documentIds', []).size() <= 5
            && request.resource.data.get('documentIds', []).toSet().size() == request.resource.data.get('documentIds', []).size();
        }
        function validAttachment(ids, previous, index) {
          return ids.size() <= index || (ids[index] is string && ids[index].size() > 0 && ids[index].size() <= 220
            && (ids[index] in previous || existsAfter(projectDocumentPath(projectId, ids[index]))));
        }
        function validAttachments(previous) {
          let ids = request.resource.data.get('documentIds', []);
          return validAttachment(ids, previous, 0) && validAttachment(ids, previous, 1)
            && validAttachment(ids, previous, 2) && validAttachment(ids, previous, 3) && validAttachment(ids, previous, 4);
        }
        function previousAttachments() {
          return resource.data.get('kind', 'note') == 'document' ? [resource.data.documentId] : resource.data.get('documentIds', []);
        }
        function validDocumentCard() {
          return request.resource.data.keys().hasOnly(['kind','documentId','x','y','pinned','color','createdBy','createdAt','updatedAt'])
            && request.resource.data.kind == 'document'
            && request.resource.data.documentId is string
            && request.resource.data.documentId.size() > 0 && request.resource.data.documentId.size() <= 220
            && request.resource.data.x is number && request.resource.data.y is number
            && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool)
            && (!('color' in request.resource.data) || request.resource.data.color in ['#ffffff','#fef3c7','#dbeafe','#dcfce7','#fce7f3','#ede9fe']);
        }
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && ((validNote() && validAttachments([]))
          || (validDocumentCard() && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && existsAfter(projectDocumentPath(projectId, request.resource.data.documentId))));
        allow update: if projectActive(projectId) && isMember(projectId)
          && ((resource.data.get('kind', 'note') == 'document' && validDocumentCard()
              && request.resource.data.documentId == resource.data.documentId
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','y','pinned','color','updatedAt']))
            || (request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
              && validNote() && validAttachments(previousAttachments())));
        allow delete: if canDeleteWork(projectId);
      }
      match /documents/{itemId} {
        function validLegacyDocument() {
          return request.resource.data.keys().hasOnly(['title','content','labelIds','taskIds','milestoneIds','createdBy','createdAt','updatedAt'])
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && request.resource.data.content is string && request.resource.data.content.toUtf8().size() <= 921600
            && validLabelIds() && validDocumentLinks();
        }
        function validV2Document() {
          return request.resource.data.keys().hasOnly(['kind','schemaVersion','title','labelIds','taskIds','milestoneIds','excerpt','contentBytes','createdBy','createdAt','updatedAt'])
            && (!('kind' in request.resource.data) || request.resource.data.kind == 'markdown')
            && request.resource.data.schemaVersion == 2
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 240
            && request.resource.data.contentBytes is int && request.resource.data.contentBytes >= 0 && request.resource.data.contentBytes <= 921600
            && validLabelIds() && validDocumentLinks()
            && existsAfter(projectDocumentBodyPath(projectId, itemId))
            && getAfter(projectDocumentBodyPath(projectId, itemId)).data.content.toUtf8().size() == request.resource.data.contentBytes;
        }
        function validDriveDocument() {
          return request.resource.data.keys().hasAll(['kind','title','driveFileId','name','mimeType','shareMode','sharedMemberIds','createdBy','createdAt','updatedAt'])
            && request.resource.data.keys().hasOnly(['kind','title','nickname','description','labelIds','taskIds','milestoneIds','driveFileId','name','mimeType','sizeBytes','resourceKey','shareMode','role','sharedMemberIds','managedPermissionIds','linkPermissionId','permissionsSyncedAt','createdBy','createdAt','updatedAt'])
            && request.resource.data.kind == 'drive'
            && itemId == 'drive_' + request.resource.data.driveFileId
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 200))
            && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 1000))
            && validLabelIds() && validDocumentLinks()
            && validDriveMetadata();
        }
        // Link-only Canva designs: design ID and edit-link token only, so stored URLs can never point elsewhere.
        function validCanvaDocument() {
          return request.resource.data.keys().hasAll(['kind','title','canvaDesignId','createdBy','createdAt','updatedAt'])
            && request.resource.data.keys().hasOnly(['kind','title','nickname','description','labelIds','taskIds','milestoneIds','canvaDesignId','canvaEditToken','createdBy','createdAt','updatedAt'])
            && request.resource.data.kind == 'canva'
            && request.resource.data.canvaDesignId is string && request.resource.data.canvaDesignId.matches('^[A-Za-z0-9_-]{8,64}$')
            && itemId == 'canva_' + request.resource.data.canvaDesignId
            && (!('canvaEditToken' in request.resource.data) || (request.resource.data.canvaEditToken is string && request.resource.data.canvaEditToken.matches('^[A-Za-z0-9_-]{4,128}$')))
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 200))
            && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 1000))
            && validLabelIds() && validDocumentLinks();
        }
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && (validLegacyDocument() || validV2Document()
          // New folder attachments are unmanaged; folders attached earlier keep their recorded mode.
          || (validDriveDocument() && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
            && (request.resource.data.mimeType != 'application/vnd.google-apps.folder' || request.resource.data.shareMode == 'unmanaged'))
          || (validCanvaDocument() && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time));
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy
          // Dispatch on the stored kind first: evaluating every schema in turn exceeds the 1000-expression limit.
          && ((!(resource.data.get('kind', 'markdown') in ['drive', 'canva']) && (validLegacyDocument() || validV2Document()))
            || (resource.data.get('kind', 'markdown') == 'canva' && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','description','labelIds','taskIds','milestoneIds','updatedAt'])
              && validCanvaDocument())
            || (resource.data.get('kind', 'markdown') == 'drive' && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','description','labelIds','taskIds','milestoneIds','role','updatedAt'])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || resource.data.createdBy == request.auth.uid)
              && validDriveDocument())
            || (resource.data.get('kind', 'markdown') == 'drive'
              && resource.data.createdBy == request.auth.uid
              && request.resource.data.shareMode == 'members'
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.updatedAt == request.time
              && request.resource.data.permissionsSyncedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedMemberIds','managedPermissionIds','permissionsSyncedAt','updatedAt'])
              && validDriveDocument()));
        allow delete: if canDeleteWork(projectId);
      }
      match /documentBodies/{itemId} {
        function validDocumentBody() {
          return request.resource.data.keys().hasOnly(['content'])
            && request.resource.data.content is string
            && request.resource.data.content.toUtf8().size() <= 921600
            && existsAfter(projectDocumentPath(projectId, itemId))
            && getAfter(projectDocumentPath(projectId, itemId)).data.schemaVersion == 2
            && getAfter(projectDocumentPath(projectId, itemId)).data.contentBytes == request.resource.data.content.toUtf8().size();
        }
        allow read: if isMember(projectId);
        allow create, update: if projectActive(projectId) && isMember(projectId) && validDocumentBody();
        allow delete: if projectActive(projectId)
          && (isAdmin(projectId) || (isMember(projectId) && get(projectDocumentPath(projectId, itemId)).data.createdBy == request.auth.uid));
      }
      match /polls/{pollId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId)
          && request.resource.data.keys().hasOnly(['question','description','options','multiple','anonymous','closed','deadline','deadlineTime','createdBy','createdAt','updatedAt'])
          && request.resource.data.question is string && request.resource.data.options is list
          && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 10
          && request.resource.data.multiple is bool && request.resource.data.closed == false && validTime('deadlineTime');
        allow update: if projectActive(projectId) && (isAdmin(projectId) || (isMember(projectId) && resource.data.createdBy == request.auth.uid))
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(['question','description','options','multiple','anonymous','closed','deadline','deadlineTime','createdBy','createdAt','updatedAt'])
          && request.resource.data.options is list && request.resource.data.multiple is bool && request.resource.data.closed is bool && validTime('deadlineTime');
        allow delete: if canDeleteWork(projectId);
      }
      match /pollVotes/{voteId} {
        function pollOf(pollId) { return get(/databases/$(database)/documents/projects/$(projectId)/polls/$(pollId)); }
        allow read: if isMember(projectId);
        allow create, update: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.userId == request.auth.uid
          && voteId == request.resource.data.pollId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['pollId','userId','optionIds','updatedAt'])
          && request.resource.data.optionIds is list && request.resource.data.optionIds.size() > 0
          && pollOf(request.resource.data.pollId).data.closed == false
          && request.resource.data.optionIds.size() <= pollOf(request.resource.data.pollId).data.options.size()
          && (pollOf(request.resource.data.pollId).data.multiple == true || request.resource.data.optionIds.size() == 1);
        allow delete: if projectActive(projectId) && isMember(projectId) && resource.data.userId == request.auth.uid
          && pollOf(resource.data.pollId).data.closed == false;
      }
      match /comments/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId)
          && request.resource.data.keys().hasOnly(['targetType','targetId','body','authorName','authorPhoto','createdBy','createdAt','updatedAt'])
          && request.resource.data.targetType in ['task','useCase','diagram','milestone']
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000;
        allow update: if projectActive(projectId) && isMember(projectId) && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt'])
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000;
        allow delete: if canDeleteWork(projectId);
      }
      match /chatMessages/{messageId} {
        function senderProfile() {
          return get(/databases/$(database)/documents/users/$(request.auth.uid));
        }
        allow read: if isMember(projectId);
        allow create: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasAll(['body','authorName','authorPhoto','createdBy','createdAt'])
          && request.resource.data.keys().hasOnly(['body','authorName','authorPhoto','createdBy','createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.authorName == senderProfile().data.displayName
          && request.resource.data.authorPhoto == senderProfile().data.photoURL
          && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 120
          && request.resource.data.authorPhoto is string && request.resource.data.authorPhoto.size() <= 2048
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /diagrams/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(['title','createdBy','createdAt','updatedAt']) && request.resource.data.title is string;
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.keys().hasOnly(['title','createdBy','createdAt','updatedAt']);
        allow delete: if canDeleteWork(projectId);
      }
      match /diagramNodes/{itemId} {
        // Diagram shapes are a shared canvas: any member may remove shapes/edges.
        // The linked useCases document keeps the normal ownership delete rule.
        function nodeKeys() { return ['diagramId','kind','x','y','w','h','label','useCaseId','createdBy','createdAt','updatedAt']; }
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(nodeKeys())
          && request.resource.data.kind in ['actor','usecase','boundary','note'] && request.resource.data.x is number && request.resource.data.y is number;
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(nodeKeys()) && request.resource.data.kind == resource.data.kind;
        allow delete: if projectActive(projectId) && isMember(projectId);
      }
      match /diagramEdges/{itemId} {
        allow read: if isMember(projectId);
        allow create: if validWorkCreate(projectId) && request.resource.data.keys().hasOnly(['diagramId','from','to','kind','createdBy','createdAt','updatedAt'])
          && request.resource.data.kind in ['association','include','extend','generalization'];
        allow update: if projectActive(projectId) && isMember(projectId) && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.keys().hasOnly(['diagramId','from','to','kind','createdBy','createdAt','updatedAt'])
          && request.resource.data.kind in ['association','include','extend','generalization'];
        allow delete: if projectActive(projectId) && isMember(projectId);
      }
      // GitHub access that still has to be removed on GitHub (member removed, disconnected, or repo unlinked).
      match /githubRevocations/{revocationId} {
        allow read: if isAdmin(projectId);
        allow create: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasOnly(['githubUsername', 'userId', 'displayName', 'permission', 'repoOwner', 'repoName', 'reason', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.githubUsername is string && request.resource.data.githubUsername.size() > 0 && request.resource.data.githubUsername.size() <= 39
          && request.resource.data.userId is string && request.resource.data.displayName is string
          && request.resource.data.permission in ['pull', 'triage', 'push', 'maintain', 'admin']
          && request.resource.data.repoOwner is string && request.resource.data.repoName is string
          && request.resource.data.createdAt == request.time
          && (isAdmin(projectId)
            || (request.resource.data.userId == request.auth.uid && request.resource.data.reason == 'disconnected'))
          && request.resource.data.reason in ['removed', 'disconnected', 'unlinked'];
        allow update: if false;
        allow delete: if isOwner(projectId);
      }

      match /activities/{activityId} {
        allow read: if isMember(projectId);
        allow create: if projectActive(projectId) && isMember(projectId) && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['type','messageTh','messageEn','actorUid','actorName','targetId','createdAt']);
        allow update, delete: if false;
      }
      match /gachaDraws/{drawId} {
        allow read: if isMember(projectId);
        allow create: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasAll(['candidateIds','winnerIds','targetIds','candidates','results','initiatedBy','initiatedByName','poolKey','animationVersion','animationStyle','createdAt'])
          && request.resource.data.keys().hasOnly(['candidateIds','winnerIds','targetIds','candidates','results','initiatedBy','initiatedByName','poolKey','animationVersion','animationStyle','createdAt'])
          && request.resource.data.initiatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.animationVersion == 1
          && request.resource.data.animationStyle in ['golden','pack']
          && request.resource.data.poolKey is string && request.resource.data.poolKey.size() == 64
          && request.resource.data.candidateIds is list && request.resource.data.candidateIds.size() > 0 && request.resource.data.candidateIds.size() <= 100
          && request.resource.data.candidateIds.hasOnly(get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds)
          && request.resource.data.winnerIds is list && request.resource.data.winnerIds.size() > 0 && request.resource.data.winnerIds.size() <= 50
          && request.resource.data.winnerIds.hasOnly(request.resource.data.candidateIds)
          && request.resource.data.targetIds is list && request.resource.data.targetIds.size() > 0 && request.resource.data.targetIds.size() <= 20
          && request.resource.data.results is list && request.resource.data.results.size() == request.resource.data.targetIds.size()
          && request.resource.data.candidates is list && request.resource.data.candidates.size() == request.resource.data.candidateIds.size();
        allow update, delete: if false;
      }
      match /gachaBags/{poolKey} {
        allow read: if isMember(projectId);
        allow create: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasOnly(['candidateIds','winCounts','updatedAt'])
          && request.resource.data.candidateIds is list && request.resource.data.candidateIds.size() > 0 && request.resource.data.candidateIds.size() <= 100
          && request.resource.data.candidateIds.hasOnly(get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds)
          && request.resource.data.winCounts is map && request.resource.data.updatedAt == request.time;
        allow update: if projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasOnly(['candidateIds','winCounts','updatedAt'])
          && request.resource.data.candidateIds == resource.data.candidateIds
          && request.resource.data.winCounts is map && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /summary/rebuildLease {
        allow read: if isMember(projectId) && projectActive(projectId);
        allow create: if isMember(projectId) && projectActive(projectId) && validLease();
        allow update: if isMember(projectId) && projectActive(projectId) && validLease()
          && (resource.data.expiresAt <= request.time
            || (resource.data.ownerUid == request.auth.uid && request.resource.data.token == resource.data.token));
        allow delete: if isMember(projectId) && projectActive(projectId) && resource.data.ownerUid == request.auth.uid;
        function validLease() {
          return request.resource.data.keys().hasOnly(['ownerUid', 'token', 'expiresAt'])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 128
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(120, 's');
        }
      }
      match /summary/{docId} {
        allow read: if docId == 'main' && isMember(projectId);
        allow create, update: if docId == 'main' && projectActive(projectId) && isMember(projectId)
          && request.resource.data.keys().hasAll(['version','openTasks','openCount','openByStatus','openByMilestone','truncated','milestones','doneTotal','doneByMilestone','rebuiltAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['version','openTasks','openCount','openByStatus','openByMilestone','truncated','milestones','doneTotal','doneByMilestone','rebuiltAt','updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.openTasks is map && request.resource.data.openTasks.size() <= 500
          && request.resource.data.openCount is int && request.resource.data.openCount >= 0
          && request.resource.data.openByStatus is map
          && request.resource.data.openByMilestone is map
          && request.resource.data.truncated is bool
          && request.resource.data.milestones is map
          && request.resource.data.doneTotal is int && request.resource.data.doneTotal >= 0
          && request.resource.data.doneByMilestone is map
          && request.resource.data.rebuiltAt is timestamp
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Feedback about ProjectSpace itself. Users read only their own; trusted site staff triage all.
    match /siteFeedback/{feedbackId} {
      allow read: if isSiteStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['title','body','category','status','page','adminReply','userId','userName','userEmail','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() <= 3000
        && request.resource.data.category in ['idea','bug','question','other']
        && request.resource.data.status == 'open' && request.resource.data.adminReply == '';
      allow update: if isSiteStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminReply','updatedAt'])
        && request.resource.data.status in ['open','in_review','resolved','declined']
        && request.resource.data.adminReply is string && request.resource.data.adminReply.size() <= 3000;
      allow delete: if isSiteStaff() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'open');
    }

    // Site roles are provisioned out of band in Firebase Console. Clients may only resolve their own role.
    match /siteAdmins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /memberships/{membershipId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/memberships/$(membershipId))
        || resource.data.userId == request.auth.uid || isMember(resource.data.projectId));
      allow list: if isMember(resource.data.projectId);
      allow create: if signedIn() && validRole(request.resource.data.role) && githubHandleProven() && (
        (request.resource.data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.archived == false
          && request.resource.data.role == 'owner')
        ||
        (request.resource.data.userId == request.auth.uid
          && membershipId == request.resource.data.projectId + '_' + request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.inviteId is string
          && projectActive(request.resource.data.projectId)
          && !('githubPermission' in request.resource.data)
          && validInviteJoin(request.resource.data))
      );
      allow update: if (projectActive(resource.data.projectId) && isOwner(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'githubPermission'])
        && (resource.data.role != 'owner' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
        || (projectActive(resource.data.projectId) && signedIn() && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['githubUsername', 'githubId'])
        && githubHandleProven());
      allow delete: if projectActive(resource.data.projectId) && signedIn() && resource.data.role != 'owner' && (
        request.auth.uid == resource.data.userId || isOwner(resource.data.projectId)
        || (isAdmin(resource.data.projectId) && resource.data.role == 'member'));
    }

    match /invites/{inviteId} {
      // Members retain access to invite status; outsiders can only preview usable links.
      allow get: if signedIn() && (isMember(resource.data.projectId)
        || (inviteAvailable(resource.data) && projectActive(resource.data.projectId)));
      allow list: if isAdmin(resource.data.projectId);
      allow create: if projectActive(request.resource.data.projectId) && isAdmin(request.resource.data.projectId)
        && validInviteSettings(request.resource.data) && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.get('usesCount', 0) == 0
        && (request.resource.data.role == 'member' || isOwner(request.resource.data.projectId));
      allow update: if projectActive(resource.data.projectId) && signedIn() && (
        (isAdmin(resource.data.projectId) && resource.data.status != 'revoked'
          && validInviteSettings(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','role','expiresAt','maxUses','status','updatedAt'])
          && (isOwner(resource.data.projectId)
            || (resource.data.role == 'member' && request.resource.data.role == 'member')
            || (resource.data.role == 'admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))))
        || (inviteAvailable(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usesCount','updatedAt'])
          && request.resource.data.usesCount == resource.data.get('usesCount', 0) + 1
          && request.resource.data.updatedAt == request.time
          && !exists(membershipPath(resource.data.projectId, request.auth.uid))
          && getAfter(membershipPath(resource.data.projectId, request.auth.uid)).data.userId == request.auth.uid
          && getAfter(membershipPath(resource.data.projectId, request.auth.uid)).data.inviteId == inviteId)
      );
      allow delete: if false;
    }
  }
}
