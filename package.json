{
  "name": "project-space-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:rules": "node scripts/sync-rules.js",
    "build": "npm run sync:rules && tsc --noEmit && vite build && node scripts/report-bundle-size.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "ALLOWED_EMAIL_DOMAINS=example.com npm run sync:rules && firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "firebase": "^12.3.0",
    "marked": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "firebase-tools": "^14.16.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
